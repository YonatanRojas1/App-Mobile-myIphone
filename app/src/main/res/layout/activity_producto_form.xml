<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical" tools:context=".vendedor.ProductoFormActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Widget.MyIphone.Toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dim_16">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_nombre" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_serie" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSerie" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_alm" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAlmacenamiento" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_color" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_precio" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPrecio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_stock" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_imagen" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etImagenUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/vend_f_desc" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swDestacado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_12" android:text="@string/vend_f_destacado" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardar" style="@style/Widget.MyIphone.Button.Vendedor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_20" android:text="@string/vend_guardar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

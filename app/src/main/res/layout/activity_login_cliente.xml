<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_navy"
    android:fillViewport="true"
    tools:context=".cliente.LoginClienteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/dim_24"
            android:paddingTop="@dimen/dim_48"
            android:paddingEnd="@dimen/dim_24"
            android:paddingBottom="@dimen/dim_32">

            <ImageView
                android:layout_width="@dimen/dim_64"
                android:layout_height="@dimen/dim_64"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_myiphone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:text="@string/auth_login_titulo_c"
                android:textAppearance="@style/TextAppearance.MyIphone.Headline.OnDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_4"
                android:gravity="center"
                android:text="@string/auth_login_sub_c"
                android:textAppearance="@style/TextAppearance.MyIphone.Body"
                android:textColor="@color/color_on_dark_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:padding="@dimen/dim_24">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:hint="@string/auth_email"
                app:startIconDrawable="@drawable/ico_email"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:hint="@string/auth_password"
                app:startIconDrawable="@drawable/ico_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvOlvidePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/dim_8"
                android:padding="@dimen/dim_4"
                android:text="@string/auth_olvide"
                android:textColor="@color/color_primary"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_13" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginC"
                style="@style/Widget.MyIphone.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_22"
                android:text="@string/auth_btn_ingresar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginHuella"
                style="@style/Widget.MyIphone.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_12"
                android:text="@string/auth_btn_huella"
                app:icon="@drawable/ic_huella"
                app:iconGravity="textStart"
                app:iconTint="@color/color_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginGoogle"
                style="@style/Widget.MyIphone.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_12"
                android:text="@string/auth_btn_google"
                app:icon="@drawable/ico_google_login"
                app:iconGravity="textStart"
                app:iconTint="@null" />

            <TextView
                android:id="@+id/tvRegistrarC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_16"
                android:gravity="center"
                android:padding="@dimen/dim_6"
                android:text="@string/auth_ir_registro"
                android:textColor="@color/color_primary"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="@dimen/text_14" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

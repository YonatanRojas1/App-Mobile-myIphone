<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_navy"
    android:fillViewport="true"
    tools:context=".cliente.RegistroClienteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/dim_24"
            android:paddingTop="@dimen/dim_48"
            android:paddingEnd="@dimen/dim_24"
            android:paddingBottom="@dimen/dim_32">

            <ImageView
                android:layout_width="@dimen/dim_64"
                android:layout_height="@dimen/dim_64"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_myiphone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:text="@string/auth_reg_titulo_c"
                android:textAppearance="@style/TextAppearance.MyIphone.Headline.OnDark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_4"
                android:gravity="center"
                android:text="@string/auth_reg_sub_c"
                android:textAppearance="@style/TextAppearance.MyIphone.Body"
                android:textColor="@color/color_on_dark_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:padding="@dimen/dim_24">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:hint="@string/auth_nombres"
                app:startIconDrawable="@drawable/ico_nombres"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombresC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:hint="@string/auth_email"
                app:startIconDrawable="@drawable/ico_email"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:hint="@string/auth_password"
                app:startIconDrawable="@drawable/ico_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MyIphone.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_14"
                android:hint="@string/auth_confirmar"
                app:startIconDrawable="@drawable/ico_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarC"
                style="@style/Widget.MyIphone.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dim_22"
                android:text="@string/auth_btn_registrar" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

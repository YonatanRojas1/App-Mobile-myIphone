<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/dim_10">
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/dim_4" android:hint="@string/comp_buscar" app:startIconDrawable="@drawable/ico_buscar">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBuscar" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipsSerie" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="@dimen/dim_4" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipTodos" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/comp_todos" />
            <com.google.android.material.chip.Chip android:id="@+id/chip17" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/serie_17" />
            <com.google.android.material.chip.Chip android:id="@+id/chip16" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/serie_16" />
            <com.google.android.material.chip.Chip android:id="@+id/chip15" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/serie_15" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCatalogo" android:layout_width="match_parent" android:layout_height="match_parent" tools:listitem="@layout/item_iphone" />
        <TextView android:id="@+id/tvVacio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/comp_sin_resultados" android:textAppearance="@style/TextAppearance.MyIphone.Body" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

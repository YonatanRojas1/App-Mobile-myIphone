<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical" tools:context=".comprador.ProductoDetalleActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Widget.MyIphone.Toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <ScrollView android:id="@+id/contenido" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="invisible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/dim_260" android:background="@color/color_primary_container">
                <ImageView android:id="@+id/ivProducto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="@dimen/dim_40" android:contentDescription="@string/app_name" android:src="@drawable/ic_iphone" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_sheet_top" android:orientation="vertical" android:padding="@dimen/dim_20">
                <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.MyIphone.Headline" />
                <TextView android:id="@+id/tvPrecio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.MyIphone.Price" android:textSize="@dimen/text_22" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:orientation="horizontal">
                    <com.google.android.material.chip.Chip android:id="@+id/chipAlmacenamiento" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipColor" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dim_8" android:checkable="false" />
                </LinearLayout>
                <TextView android:id="@+id/tvStock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_8" android:textAppearance="@style/TextAppearance.MyIphone.Caption" android:textColor="@color/color_success" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_16" android:text="@string/comp_descripcion" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
                <TextView android:id="@+id/tvDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_4" android:textAppearance="@style/TextAppearance.MyIphone.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_12" android:text="@string/comp_garantia" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_16" android:gravity="center_vertical" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMenos" style="@style/Widget.MyIphone.Button.Outlined" android:layout_width="@dimen/dim_44" android:layout_height="@dimen/dim_44" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/sim_menos" />
                    <TextView android:id="@+id/tvCantidad" android:layout_width="@dimen/dim_48" android:layout_height="wrap_content" android:gravity="center" android:text="@string/cantidad_inicial" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMas" style="@style/Widget.MyIphone.Button.Outlined" android:layout_width="@dimen/dim_44" android:layout_height="@dimen/dim_44" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/sim_mas" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAgregar" style="@style/Widget.MyIphone.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_16" android:text="@string/comp_agregar_carrito" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnComprarAhora" style="@style/Widget.MyIphone.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:text="@string/comp_comprar_ahora" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

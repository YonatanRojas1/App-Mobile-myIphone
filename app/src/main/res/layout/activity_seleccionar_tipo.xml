<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_navy"
    android:fillViewport="true"
    tools:context=".SeleccionarTipoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="56dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_circle_soft">

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo_myiphone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.MyIphone.Headline.OnDark"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/splash_lema"
            android:textAppearance="@style/TextAppearance.MyIphone.Body"
            android:textColor="@color/color_on_dark_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="@string/bienvenida_pregunta"
            android:textAppearance="@style/TextAppearance.MyIphone.Body"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tipoCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_soy_comprador" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tipoVendedor"
            style="@style/Widget.MyIphone.Button.Vendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_soy_vendedor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tipoAdmin"
            style="@style/Widget.MyIphone.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_acceso_admin"
            android:textColor="@color/color_admin_on_dark"
            app:icon="@drawable/ico_password"
            app:iconTint="@color/color_admin_on_dark" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/bienvenida_pie"
            android:textAppearance="@style/TextAppearance.MyIphone.Caption"
            android:textColor="@color/color_on_dark_muted" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

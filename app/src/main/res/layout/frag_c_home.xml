<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/tvSaludo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comp_saludo_simple" android:textAppearance="@style/TextAppearance.MyIphone.Headline" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comp_sub_home" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_gradient_navy" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comp_banner_t" android:textAppearance="@style/TextAppearance.MyIphone.Title" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/comp_banner_s" android:textAppearance="@style/TextAppearance.MyIphone.Caption" android:textColor="@color/color_on_dark_muted" />
            </LinearLayout>
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_iphone" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/comp_destacados" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDestacados" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clipToPadding="false" tools:listitem="@layout/item_iphone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnVerCatalogo" style="@style/Widget.MyIphone.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/comp_ver_catalogo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

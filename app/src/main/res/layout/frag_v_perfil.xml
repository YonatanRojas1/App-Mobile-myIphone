<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvInicial" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/color_vendedor" android:gravity="center" android:textColor="@color/white" android:textSize="36sp" android:fontFamily="@font/poppins_bold" />
        <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.MyIphone.Headline" android:textSize="22sp" />
        <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_badge" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:text="@string/vend_rol" android:textColor="@color/color_vendedor" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/auth_nombres_v" app:startIconDrawable="@drawable/ico_nombres" app:boxStrokeColor="@color/color_vendedor" app:hintTextColor="@color/color_vendedor">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardar" style="@style/Widget.MyIphone.Button.Vendedor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/comp_guardar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCambiarPassword" style="@style/Widget.MyIphone.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/comp_cambiar_password" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCerrarSesion" style="@style/Widget.MyIphone.Button.Danger" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/op_cerrar_sesion_v" />
    </LinearLayout>
</ScrollView>

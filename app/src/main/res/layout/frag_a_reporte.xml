<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dim_12">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipsPeriodo" android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipTodo" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_p_todo" android:checked="true" />
                <com.google.android.material.chip.Chip android:id="@+id/chipHoy" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_p_hoy"  />
                <com.google.android.material.chip.Chip android:id="@+id/chip7" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_p_7"  />
                <com.google.android.material.chip.Chip android:id="@+id/chip30" style="@style/Widget.MyIphone.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_p_30"  />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/dim_6" android:layout_marginTop="@dimen/dim_10" android:background="@drawable/bg_gradient_navy" android:orientation="vertical" android:padding="@dimen/dim_20">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_ventas_periodo" android:textAppearance="@style/TextAppearance.MyIphone.Caption" android:textColor="@color/color_admin_on_dark" />
            <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sim_vacio" android:textAppearance="@style/TextAppearance.MyIphone.Headline.OnDark" android:textSize="@dimen/text_28" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.card.MaterialCardView style="@style/Widget.MyIphone.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="@dimen/dim_6">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dim_14">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vend_pedidos_total" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
                    <TextView android:id="@+id/tvNumPedidos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_4" android:text="@string/sim_vacio" android:textColor="@color/color_admin" android:textAppearance="@style/TextAppearance.MyIphone.Title" android:textSize="@dimen/text_20" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView><com.google.android.material.card.MaterialCardView style="@style/Widget.MyIphone.Card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="@dimen/dim_6">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dim_14">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/adm_ticket" android:textAppearance="@style/TextAppearance.MyIphone.Caption" />
                    <TextView android:id="@+id/tvTicket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_4" android:text="@string/sim_vacio" android:textColor="@color/color_admin" android:textAppearance="@style/TextAppearance.MyIphone.Title" android:textSize="@dimen/text_20" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView></LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/dim_6" android:layout_marginTop="@dimen/dim_12" android:text="@string/adm_mas_vendidos" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
        <TextView android:id="@+id/tvTop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dim_6" android:textAppearance="@style/TextAppearance.MyIphone.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCompartir" style="@style/Widget.MyIphone.Button.Admin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/dim_6" android:layout_marginTop="@dimen/dim_14" android:text="@string/adm_compartir" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/dim_6" android:layout_marginTop="@dimen/dim_10" android:text="@string/adm_detalle_pedidos" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPedidos" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" tools:listitem="@layout/item_pedido" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

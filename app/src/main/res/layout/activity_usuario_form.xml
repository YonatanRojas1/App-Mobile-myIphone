<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" android:orientation="vertical" tools:context=".admin.UsuarioFormActivity">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" style="@style/Widget.MyIphone.Toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/dim_16">
            <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/auth_nombres" app:boxStrokeColor="@color/color_admin" app:hintTextColor="@color/color_admin" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout  style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/auth_email" app:boxStrokeColor="@color/color_admin" app:hintTextColor="@color/color_admin" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutPassword" style="@style/Widget.MyIphone.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_10" android:hint="@string/adm_password_inicial" app:endIconMode="password_toggle" app:boxStrokeColor="@color/color_admin" app:hintTextColor="@color/color_admin">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_16" android:text="@string/adm_rol" android:textAppearance="@style/TextAppearance.MyIphone.Title" />
            <RadioGroup android:id="@+id/rgRol" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbComprador" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adm_rol_comprador" android:textAppearance="@style/TextAppearance.MyIphone.Body" android:buttonTint="@color/color_admin" android:checked="true" />
                <RadioButton android:id="@+id/rbVendedor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adm_rol_vendedor" android:textAppearance="@style/TextAppearance.MyIphone.Body" android:buttonTint="@color/color_admin"  />
                <RadioButton android:id="@+id/rbAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adm_rol_admin" android:textAppearance="@style/TextAppearance.MyIphone.Body" android:buttonTint="@color/color_admin"  />
            </RadioGroup>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardar" style="@style/Widget.MyIphone.Button.Admin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dim_20" android:text="@string/adm_guardar_usuario" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

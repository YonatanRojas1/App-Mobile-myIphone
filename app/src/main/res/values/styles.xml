<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Formas ===== -->
    <style name="ShapeAppearance.MyIphone.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.MyIphone.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.MyIphone.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ===== Texto ===== -->
    <style name="TextAppearance.MyIphone.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>
    <style name="TextAppearance.MyIphone.Headline.OnDark">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TextAppearance.MyIphone.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="TextAppearance.MyIphone.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextAppearance.MyIphone.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextAppearance.MyIphone.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- ===== Botones (comprador por defecto; variantes para vendedor y administrador) ===== -->
    <style name="Widget.MyIphone.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="Widget.MyIphone.Button.Vendedor">
        <item name="backgroundTint">@color/color_vendedor</item>
    </style>
    <style name="Widget.MyIphone.Button.Admin">
        <item name="backgroundTint">@color/color_admin</item>
    </style>
    <style name="Widget.MyIphone.Button.Danger">
        <item name="backgroundTint">@color/color_error</item>
    </style>
    <style name="Widget.MyIphone.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/color_line</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>
    <style name="Widget.MyIphone.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!-- ===== Campos de texto ===== -->
    <style name="Widget.MyIphone.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="hintTextColor">@color/color_primary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
    </style>

    <!-- ===== Tarjetas ===== -->
    <style name="Widget.MyIphone.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ===== Barra superior ===== -->
    <style name="Widget.MyIphone.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/color_bar</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- ===== Navegación inferior: un estilo por rol ===== -->
    <style name="Widget.MyIphone.ActiveIndicator.Comprador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_container</item>
    </style>
    <style name="Widget.MyIphone.ActiveIndicator.Vendedor" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_vendedor_container</item>
    </style>
    <style name="Widget.MyIphone.ActiveIndicator.Admin" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_admin_container</item>
    </style>

    <style name="Widget.MyIphone.BottomNav.Comprador" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="itemIconTint">@color/nav_item_comprador</item>
        <item name="itemTextColor">@color/nav_item_comprador</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MyIphone.ActiveIndicator.Comprador</item>
    </style>
    <style name="Widget.MyIphone.BottomNav.Vendedor" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="itemIconTint">@color/nav_item_vendedor</item>
        <item name="itemTextColor">@color/nav_item_vendedor</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MyIphone.ActiveIndicator.Vendedor</item>
    </style>
    <style name="Widget.MyIphone.BottomNav.Admin" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="itemIconTint">@color/nav_item_admin</item>
        <item name="itemTextColor">@color/nav_item_admin</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MyIphone.ActiveIndicator.Admin</item>
    </style>

    <!-- ===== Chips de filtro ===== -->
    <style name="Widget.MyIphone.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/color_line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>
</resources>
